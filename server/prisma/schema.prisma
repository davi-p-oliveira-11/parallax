generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
}

model user {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  email String
  password String
  post post[]
  @@unique([email])
}

model post {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  content String
  cover String?
  user user @relation(fields: [userId], references: [id])
  userId String @db.ObjectId
}
